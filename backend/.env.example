# Backend tooling environment. Copy to backend/.env and fill in real values.
# Never commit real key values -- .gitignore keeps .env / .env.* out of git.

SUPABASE_URL=https://<project-ref>.supabase.co

# New-format server-side SECRET key (sb_secret_...). Server-side only --
# NEVER ship in a client / APK. Used by:
#   Server-side admin scripts and edge function secrets
SUPABASE_SECRET_KEY=

# New-format PUBLISHABLE key (sb_publishable_...). Safe to be public, but not
# hardcoded. Used by:
#   scripts/benchmark_search_pipeline.mjs   (npm run benchmark:search)
#   ../tools/publish_catalog_release.py     (production publish verification)
SUPABASE_PUBLISHABLE_KEY=

# NOTE: SUPABASE_DB_URL -- consumed by .github/workflows/rls-drift-check.yml --
# is a Postgres connection string (DB password), a SEPARATE credential class,
# not a Supabase API key. It lives only as a GitHub Actions repository secret.

# Legacy Supabase keys (anon / service_role JWTs) are still accepted as a
# fallback during the API-key migration -- see docs/runbooks/OPERATIONS_RUNBOOK.md.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
