LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=

# Saaras v3 detects Tamil, English, Hindi, and other supported languages.
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=transcribe

# Bulbul v3 is Tamil-first by default. Change both values at deploy time.
SARVAM_TTS_LANGUAGE=ta-IN
SARVAM_TTS_SPEAKER=kavitha

# Server-side ai-coustics Voice Focus strength (0.0-1.0).
SAARTHI_NOISE_ENHANCEMENT_LEVEL=0.8

# Supabase Cloud Chat Logging
SUPABASE_URL=https://houpzsxmwemoztpuigmo.supabase.co
# Server-side only. NEVER ship this in a client / APK. Required for chat logging:
# public.chat_logs denies client reads and only the secret / service_role key
# may write to it. Use the new-format secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy fallback, still read during the API-key migration (see CUTOVER.md):
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOGS_TABLE=chat_logs
