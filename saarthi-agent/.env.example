# Origin of the MSS REST backend the agent syncs its catalog from (no /v1).
API_BASE_URL=https://mssapi.msmeschemes.org

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=

# Realtime dialogue defaults: focused, short, and non-reasoning for low latency.
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_TEMPERATURE=0.25
SARVAM_LLM_MAX_TOKENS=256
SARVAM_LLM_FREQUENCY_PENALTY=0.1
SARVAM_LLM_PRESENCE_PENALTY=0
SARVAM_LLM_REASONING_EFFORT=none

# Saaras v3 detects Tamil, English, Hindi, and other supported languages.
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=transcribe

# Bulbul v3 is Tamil-first by default. Change both values at deploy time.
SARVAM_TTS_LANGUAGE=ta-IN
SARVAM_TTS_SPEAKER=kavitha

# Server-side ai-coustics Voice Focus strength (0.0-1.0).
SAARTHI_NOISE_ENHANCEMENT_LEVEL=0.8

